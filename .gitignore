# Output: the world save (over 1 GB).
/out/

# Virtual environment. In a worktree this is often a symlink back to the main
# checkout, so there is no trailing slash.
/.venv

# Raw DEM data (83 MB; sources in docs/building.md).
/data/dem/

# Pipeline intermediates and images.
/data/*.npy
/data/*.png
/data/*.log
/data/*.blend
/data/*.blend1

# Raw screen recordings for the demo (raw-4.mov, the one in use, is 6 GB) and
# intermediates.
# Only the finished files in demo/ are tracked; rerun demo/make_demo.py to
# rebuild them.
/demo/raw-*.mov
/demo/.work/

# macOS / Python
.DS_Store
__pycache__/
*.pyc

# Claude Code's local settings (absolute paths on this machine, meaningless to
# anyone else).
/.claude/
